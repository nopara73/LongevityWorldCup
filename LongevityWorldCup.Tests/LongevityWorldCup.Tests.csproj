<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageReference Include="Microsoft.Playwright" Version="1.64.1" />
    <PackageReference Include="Markdig" Version="1.5.0" />
    <PackageReference Include="coverlet.msbuild" Version="10.1.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LongevityWorldCup.Website\LongevityWorldCup.Website.csproj" />
    <ProjectReference Include="..\LongevityWorldCup.ApplicationReviewer\LongevityWorldCup.ApplicationReviewer.csproj" />
    <Compile Include="..\LongevityWorldCup.MarkdownPageGenerator\DocumentationLinks.cs" Link="DocumentationLinks.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Node-free publish check removes node_modules before browser tests. -->
    <Content Include="..\LongevityWorldCup.Website\node_modules\chart.js\dist\chart.umd.js"
             Link="Fixtures\chart.umd.js"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
    <Content Include="..\LongevityWorldCup.Website\node_modules\cropperjs\dist\cropper.min.js"
             Link="Fixtures\%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
